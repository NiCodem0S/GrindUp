@page "/"

<PageTitle>Home </PageTitle>

<h1>Hello world!</h1>

Welcome to your new app.
<div class="card-design">
    <div class="card-header">
        <div class="card-title-wrapper">
            <h2 class="card-title">LeetCode</h2>
            <div class="card-meta">
                <div class="avatar" aria-hidden="true">Yg</div>
                <span class="card-creator">YglAK</span>
            </div>
        </div>
        <div class="card-badges">
            <div class="badge">
                <strong>Challenge</strong>
                <span>2 problems / day</span>
            </div>
            <div class="badge muted">
                <strong>Duration</strong>
                <span>1 month</span>
            </div>
        </div>
    </div>

    <div class="card-body">
        <p class="card-description">Solve coding problems, learn patterns, and improve algorithmic thinking. Small daily wins add up.</p>

        <div class="card-stats">
            <div class="progress" role="progressbar" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width:10%"></div>
            </div>
            <div class="stats-right">
                <span class="streak">🔥 6-day streak</span>
                <span class="small-muted">• 40% this period</span>
            </div>
        </div>
    </div>

    <div class="card-footer">
        <button class="card-join-btn">Join</button>
        <button class="card-ghost" title="More options">⋯</button>
    </div>
</div>
